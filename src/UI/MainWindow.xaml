<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Livn Tools"
    Width="1240" Height="820" MinWidth="980" MinHeight="620"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None" ResizeMode="CanResize"
    Background="#101217" FontFamily="Segoe UI" FontSize="13"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">

    <!-- Yerel pencere cercevesi: yeniden boyutlandirma, Aero Snap ve DPI olcekleme calisir.
         (Eski surumdeki AllowsTransparency=True donanim hizlandirmayi ve boyutlandirmayi kapatiyordu.) -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <SolidColorBrush x:Key="BgDeep"      Color="#101217"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#151820"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1B1F29"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#242A36"/>
        <SolidColorBrush x:Key="Accent"      Color="#6950B5"/>
        <SolidColorBrush x:Key="AccentLight" Color="#C1ADF3"/>
        <SolidColorBrush x:Key="Blue"        Color="#4A90D9"/>
        <SolidColorBrush x:Key="Green"       Color="#5CBF60"/>
        <SolidColorBrush x:Key="Orange"      Color="#FFA726"/>
        <SolidColorBrush x:Key="Red"         Color="#F4675C"/>
        <SolidColorBrush x:Key="Text1"       Color="#F0F2F7"/>
        <SolidColorBrush x:Key="Text2"       Color="#B5BECE"/>
        <SolidColorBrush x:Key="Text3"       Color="#939FB2"/>
        <SolidColorBrush x:Key="Line"        Color="#303747"/>

        <!-- Klavye odagi: tum ozel sablonlarda gorunur odak cercevesi -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="#C1ADF3" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SECIM LISTELERI: yerel ComboBox klavye davranisi korunur. -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#35304D"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#443863"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="#414B60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6,32,6"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#B5BECE" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource BgPanel}" BorderBrush="#6950B5" BorderThickness="1" CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#9F89D5"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentLight}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KAYDIRMA: surukleme ve bos kanala tiklayarak sayfalama -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#4A5264" CornerRadius="4" Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#78839A"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentLight}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBack" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="PageForward" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="14"/><Setter Property="MinHeight" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- BUTONLAR -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#232936"/>
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="BorderBrush" Value="#414B60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6950B5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D2A55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#6950B5"/>
            <Setter Property="BorderBrush" Value="#9F89D5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#3A1C22"/>
            <Setter Property="BorderBrush" Value="#8A3A3A"/>
            <Setter Property="Foreground" Value="#FFB4AC"/>
        </Style>
        <Style x:Key="BtnPreset" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="BtnCaption" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Foreground" Value="#B5BECE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252C39"/>
                                <Setter Property="Foreground" Value="#F0F2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ONAY KUTUSU -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="bx" Width="18" Height="18" CornerRadius="4" Margin="0,1,10,0" VerticalAlignment="Top"
                                    Background="#15162C" BorderBrush="#4A4B72" BorderThickness="1.5">
                                <TextBlock x:Name="chk" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Top" RecognizesAccessKey="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bx" Property="Background" Value="#6950B5"/>
                                <Setter TargetName="bx" Property="BorderBrush" Value="#C1ADF3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bx" Property="BorderBrush" Value="#C1ADF3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ROZET -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="6,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- GEZINTI LISTESI -->
        <Style x:Key="SetupSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Text1}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}" Foreground="{StaticResource Text1}" HorizontalContentAlignment="Left"
                                          FocusVisualStyle="{StaticResource FocusRing}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="#1B1F29" BorderBrush="#414B60" BorderThickness="1" CornerRadius="5" Padding="10,9">
                                            <DockPanel>
                                                <TextBlock x:Name="SectionArrow" Text="+" Foreground="#C1ADF3" Width="22" FontWeight="Bold"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SectionArrow" Property="Text" Value="−"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#C1ADF3"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SectionContent" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="SectionContent" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="selection" Padding="8,5" Margin="2" CornerRadius="4" Background="#151A23" BorderBrush="#303747" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="selection" Property="Background" Value="#3A3154"/><Setter TargetName="selection" Property="BorderBrush" Value="#A899EE"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="selection" Property="BorderBrush" Value="#F0F2F7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#B5BECE"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="#6950B5" Visibility="Hidden"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232936"/>
                                <Setter Property="Foreground" Value="#F0F2F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#302742"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#F0F2F7"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavHeader" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="20,14,0,4" TextElement.FontSize="11" TextElement.FontWeight="Bold" TextElement.Foreground="#939FB2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#232936"/>
            <Setter Property="Foreground" Value="#F0F2F7"/>
            <Setter Property="BorderBrush" Value="#4A4B72"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1B1F29"/>
            <Setter Property="Foreground" Value="#B5BECE"/>
            <Setter Property="BorderBrush" Value="#303747"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#252C39"/>
            <Setter Property="Foreground" Value="#6950B5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- AYAR SATIRI SABLONU -->
        <DataTemplate x:Key="TweakTemplate">
            <Border x:Name="row" Background="{StaticResource BgCard}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10"
                    ToolTip="{Binding ToolTipText}" ToolTipService.ShowDuration="30000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding IsSupported}"
                              AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" Margin="0,2,14,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource Text1}"/>
                    </CheckBox>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="MEVCUT DURUM" FontSize="10" Foreground="{StaticResource Text3}" HorizontalAlignment="Right" Margin="0,0,0,5"/>
                        <Border x:Name="state" Style="{StaticResource Badge}" Background="#252C39" BorderBrush="#414B60" MaxWidth="180">
                            <TextBlock x:Name="stateTxt" Text="{Binding StateText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="28,8,0,0">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12" LineHeight="19"/>
                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#FFA726" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding HasReason, Converter={StaticResource B2V}}"/>
                        <TextBlock x:Name="res" Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource Text2}"
                                   Visibility="{Binding HasLastResult, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="28,12,0,0">
                        <Border x:Name="selectedBadge" Background="#302742" CornerRadius="4" Padding="7,3" Margin="0,0,8,4" Visibility="Collapsed">
                            <TextBlock Text="İşlem için seçildi" FontSize="11" Foreground="{StaticResource AccentLight}"/>
                        </Border>
                        <Border x:Name="risk" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,8,4" Background="Transparent" BorderBrush="#414B60">
                            <TextBlock x:Name="riskTxt" Text="{Binding RiskText}" FontSize="11" Foreground="{StaticResource Text2}"/>
                        </Border>
                        <TextBlock Text="{Binding EvidenceText}" FontSize="11" Foreground="{StaticResource Text3}" Margin="0,4,12,4"/>
                        <TextBlock Text="{Binding RestartText}" FontSize="11" Foreground="{StaticResource Text2}" Margin="0,4,12,4"/>
                        <TextBlock Text="Önceki ayar kayıtlı" FontSize="11" Foreground="{StaticResource AccentLight}" Margin="0,4,0,4"
                                   Visibility="{Binding Owned, Converter={StaticResource B2V}}"/>
                    </WrapPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="#6950B5"/>
                    <Setter TargetName="row" Property="Background" Value="#252235"/>
                    <Setter TargetName="selectedBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Applied">
                    <Setter TargetName="state" Property="Background" Value="#16301C"/>
                    <Setter TargetName="state" Property="BorderBrush" Value="#2F6B38"/>
                    <Setter TargetName="stateTxt" Property="Foreground" Value="#7FD686"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Partial">
                    <Setter TargetName="state" Property="Background" Value="#33260F"/>
                    <Setter TargetName="state" Property="BorderBrush" Value="#7A5A1E"/>
                    <Setter TargetName="stateTxt" Property="Foreground" Value="#FFC266"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="Unknown">
                    <Setter TargetName="state" Property="Background" Value="#3A1C22"/>
                    <Setter TargetName="stateTxt" Property="Foreground" Value="#FFB4AC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKind}" Value="NotSupported">
                    <Setter TargetName="stateTxt" Property="Foreground" Value="#FFC266"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="Medium">
                    <Setter TargetName="riskTxt" Property="Foreground" Value="#FFC266"/>
                    <Setter TargetName="risk" Property="BorderBrush" Value="#7A5A1E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="High">
                    <Setter TargetName="riskTxt" Property="Foreground" Value="#FF9A8F"/>
                    <Setter TargetName="risk" Property="BorderBrush" Value="#8A3A3A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="Security">
                    <Setter TargetName="riskTxt" Property="Foreground" Value="White"/>
                    <Setter TargetName="risk" Property="Background" Value="#8A2A2A"/>
                    <Setter TargetName="risk" Property="BorderBrush" Value="#C24A4A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="Success">
                    <Setter TargetName="res" Property="Foreground" Value="#7FD686"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="Failed">
                    <Setter TargetName="res" Property="Foreground" Value="#FF9A8F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="NotSupported">
                    <Setter TargetName="res" Property="Foreground" Value="#FFC266"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- TEMIZLIK SATIRI SABLONU -->
        <DataTemplate x:Key="CleanupTemplate">
            <Border x:Name="row" Background="#1B1F29" BorderBrush="#303747" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10"
                    ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#B5BECE" FontSize="12" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#8C8CA6" FontSize="12" Margin="0,3,0,0"
                                       Visibility="{Binding HasReason, Converter={StaticResource B2V}}"/>
                            <TextBlock x:Name="res" Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="#B5BECE"
                                       Visibility="{Binding HasLastResult, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top" Background="Transparent" BorderBrush="#5A3A3A">
                        <TextBlock Text="Geri alınamaz" FontSize="11" Foreground="#D9A09A"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="row" Property="BorderBrush" Value="#6950B5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="Success">
                    <Setter TargetName="res" Property="Foreground" Value="#7FD686"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="Partial">
                    <Setter TargetName="res" Property="Foreground" Value="#FFC266"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastResultKind}" Value="Failed">
                    <Setter TargetName="res" Property="Foreground" Value="#FF9A8F"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- GRUP SABLONLARI -->
        <DataTemplate x:Key="TweakGroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#C1ADF3" Margin="2,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakTemplate}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CleanupGroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#C1ADF3" Margin="2,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CleanupTemplate}" Focusable="False"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="#303747" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- baslik -->
                <RowDefinition Height="Auto"/> <!-- sistem cubugu -->
                <RowDefinition Height="Auto"/> <!-- kurtarma bandi -->
                <RowDefinition Height="*"/>    <!-- icerik -->
                <RowDefinition Height="Auto"/> <!-- ilerleme -->
                <RowDefinition Height="Auto"/> <!-- gunluk -->
                <RowDefinition Height="28"/>   <!-- durum cubugu -->
            </Grid.RowDefinitions>

            <!-- BASLIK CUBUGU -->
            <Border Grid.Row="0" Background="#101217">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#6950B5" VerticalAlignment="Center"/>
                        <TextBlock Text="LIVN TOOLS" FontSize="14" FontWeight="Bold" Foreground="#F0F2F7" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtVersion" Text="v4" FontSize="11" Foreground="#939FB2" Margin="6,2,0,0" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeBackend" Visibility="Collapsed" Background="#3A2A10" CornerRadius="8" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DENEME MODU · sistem ayarları değiştirilmez" FontSize="11" Foreground="#FFC266"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnMinimize" Style="{StaticResource BtnCaption}" Content="&#xE921;" ToolTip="Simge durumuna küçült" AutomationProperties.Name="Simge durumuna küçült"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource BtnCaption}" Content="&#xE922;" ToolTip="Ekranı kapla" AutomationProperties.Name="Ekranı kapla"/>
                        <Button x:Name="BtnClose" Style="{StaticResource BtnCaption}" Content="&#xE8BB;" ToolTip="Kapat" AutomationProperties.Name="Kapat"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SISTEM CUBUGU -->
            <Border Grid.Row="1" Background="#151820" BorderBrush="#303747" BorderThickness="0,1,0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock FontSize="11" Foreground="#B5BECE"><Run Text="CPU "/><Run x:Name="RunCpu" Text="—" Foreground="#F0F2F7" FontWeight="SemiBold"/></TextBlock>
                        <ProgressBar x:Name="ProgCpu" Maximum="100" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock FontSize="11" Foreground="#B5BECE"><Run Text="RAM "/><Run x:Name="RunRam" Text="—" Foreground="#F0F2F7" FontWeight="SemiBold"/></TextBlock>
                        <ProgressBar x:Name="ProgRam" Maximum="100" Margin="0,4,0,0" Foreground="#4A90D9"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="TxtOs" Text="Sistem bilgisi okunuyor…" FontSize="11" Foreground="#F0F2F7" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtHw" Text="" FontSize="11" Foreground="#B5BECE" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                        <Border x:Name="BadgeRestart" Visibility="Collapsed" Background="#33260F" BorderBrush="#7A5A1E" BorderThickness="1" CornerRadius="8" Padding="8,1">
                            <TextBlock x:Name="TxtRestart" Text="Yeniden başlatma bekliyor" FontSize="11" Foreground="#FFC266"/>
                        </Border>
                        <TextBlock x:Name="TxtUptime" Text="" FontSize="11" Foreground="#939FB2" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KURTARMA BANDI -->
            <Border x:Name="RecoveryBanner" Grid.Row="2" Visibility="Collapsed" Background="#3A2A10" BorderBrush="#7A5A1E" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnRecoveryRevert" Style="{StaticResource BtnPrimary}" Content="İşlem öncesine _geri al" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRecoveryKeep" Style="{StaticResource Btn}" Content="Olduğu gibi _bırak" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtRecovery" TextWrapping="Wrap" Foreground="#FFE0A6" VerticalAlignment="Center"
                               Text="Yarım kalmış bir işlem bulundu."/>
                </DockPanel>
            </Border>

            <!-- ICERIK -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#151820" BorderBrush="#303747" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="livn.tr · LiVNLOUD/livn-tools" FontSize="11" Foreground="#939FB2" Margin="20,8,8,12"/>
                        <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once"
                                 AutomationProperties.Name="Sayfalar">
                            <ListBoxItem Style="{StaticResource NavHeader}" Content="BAŞLANGIÇ"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Health" Content="Sistem Kontrolü"/>
                            <ListBoxItem Style="{StaticResource NavHeader}" Content="TEMİZLİK"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="QuickClean" Content="Hızlı Temizlik"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="AdvancedClean" Content="Gelişmiş Temizlik"/>
                            <ListBoxItem Style="{StaticResource NavHeader}" Content="SİSTEM AYARLARI"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Performance" Content="Performans"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Network" Content="Ağ"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Kernel" Content="Güvenlik ve Giriş"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="GPU" Content="GPU ve MSI"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Privacy" Content="Gizlilik"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="WinTweaks" Content="Windows Ayarları"/>
                            <ListBoxItem Style="{StaticResource NavHeader}" Content="ARAÇLAR"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Kit" Content="Kurtarma Kiti"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Setup" Content="Format Sonrası"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="Startup" Content="Başlangıç Uygulamaları"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="History" Content="Değişiklik Geçmişi"/>
                            <ListBoxItem Style="{StaticResource NavItem}" Tag="RunScript" Content="Betik Çalıştır"/>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="24,18,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,12,10">
                        <TextBlock x:Name="TxtPageTitle" Text="" FontSize="26" FontWeight="SemiBold" Foreground="#F0F2F7"/>
                        <TextBlock x:Name="TxtPageDesc" Text="" FontSize="13" Foreground="#B5BECE" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- PRESET CUBUGU (yalnizca optimizasyon sayfalari) -->
                    <Border x:Name="PresetBar" Grid.Row="1" Background="#191C26" BorderBrush="#303747" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,10">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Hazır seçimler" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                                <Button x:Name="BtnPresetMinimal" Style="{StaticResource BtnPreset}" Content="_Temel" Margin="0,0,6,6"/>
                                <Button x:Name="BtnPresetStandard" Style="{StaticResource BtnPreset}" Content="_Gizlilik" Margin="0,0,6,6"/>
                                <Button x:Name="BtnPresetAggressive" Style="{StaticResource BtnPreset}" Content="_Görünüm" Margin="0,0,6,6"/>
                                <Button x:Name="BtnPresetResponsive" Style="{StaticResource BtnPreset}" Content="Akıcı görünüm" Margin="0,0,6,6"/>
                                <Button x:Name="BtnPresetGamer" Style="{StaticResource BtnPrimary}" Content="_Oyuncu modu…" Margin="0,0,6,6" Padding="10,4" MinHeight="28"
                                        ToolTip="Oyun için uygun tüm ayarları seçer (tek adaptör varsa onu hedefler) ve doğrudan önizlemeyi açar. Güvenlik azaltması, servis kapatma ve MSI içermez. Uygulamak için önizlemede onay gerekir."/>
                                <Button x:Name="BtnPresetMaxPerf" Style="{StaticResource BtnPreset}" Content="_Maksimum performans" Margin="0,0,6,6"
                                        ToolTip="Performans odaklı ayarları işaretler (güvenlik azaltması, servis kapatma ve MSI hariç). Yalnız işaretler; önizleme ve onay gerekir."/>
                                <Button x:Name="BtnPresetClear" Style="{StaticResource BtnPreset}" Content="Seçimleri kaldır" Margin="0,0,12,6"/>
                                <Button x:Name="BtnApplyAllPages" Style="{StaticResource Btn}" Margin="0,0,0,6" Padding="10,4" MinHeight="28"
                                        Content="Tüm sayfalardaki seçimi önizle…" ToolTip="Tüm sayfalarda seçili ayarların değişiklik özetini açar. Uygulama ayrıca onay ister."/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtPresetInfo" Text="Hazır seçimler yalnızca işaretler; değişiklikler önizlemeden sonra uygulanır." Foreground="{StaticResource Text3}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SAYFA ARAC CUBUGU -->
                    <WrapPanel x:Name="Toolbar" Grid.Row="2" Margin="0,0,12,4">
                        <Button x:Name="BtnApply" Style="{StaticResource BtnPrimary}" Content="_Önizle ve uygula…" ToolTip="Seçili ayarlar için değişiklik özetini gösterir (Ctrl+Enter)."/>
                        <Button x:Name="BtnRevertPrev" Style="{StaticResource Btn}" Content="Önceki ayara _dön…" ToolTip="Seçili ayarları Livn Tools'un kaydettiği özgün değerlere döndürür."/>
                        <Button x:Name="BtnRevertDefault" Style="{StaticResource Btn}" Content="_Windows varsayılanı…" ToolTip="Seçili ayarları belgelenmiş Windows varsayılanına döndürür."/>
                        <Button x:Name="BtnBackupState" Style="{StaticResource Btn}" Content="Durum _yedeği al" ToolTip="Bu sayfadaki tüm ayarların mevcut değerlerini (olmayan değerler dahil) JSON olarak kaydeder."/>
                        <Button x:Name="BtnSelectAll" Style="{StaticResource Btn}" Content="Tümünü seç"/>
                        <Button x:Name="BtnSelectNone" Style="{StaticResource Btn}" Content="Seçimi kaldır"/>
                        <Button x:Name="BtnRefresh" Style="{StaticResource Btn}" Content="Durumu _yenile" ToolTip="Sistem durumunu yeniden okur (F5)."/>
                        <Button x:Name="BtnCleanupPreview" Style="{StaticResource Btn}" Content="Ö_nizle (boyut)…" ToolTip="Seçili temizlik öğeleri için dosya sayısı ve tahmini boyutu gösterir. Hiçbir dosyayı silmez, uygulama kapatmaz, komut çalıştırmaz."/>
                        <Button x:Name="BtnRunCleanup" Style="{StaticResource BtnPrimary}" Content="Seçilenleri _çalıştır…" ToolTip="Seçili temizlik/bakım işlemlerini çalıştırır. Geri alınamaz."/>
                    </WrapPanel>

                    <!-- LISTELER -->
                    <ScrollViewer x:Name="MainScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,12,12" Focusable="False">
                        <StackPanel>
                            <CheckBox x:Name="ChkCleanupAvailable" Content="Yalnız kullanılabilir temizlikleri göster" IsChecked="True" Visibility="Collapsed" Foreground="#B5BECE" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtPageInfo" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B5BECE" FontSize="12" Margin="0,0,0,12"/>
                            <StackPanel x:Name="ExternalToolsPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <TextBlock Text="Harici performans araçları" FontSize="15" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,8"/>
                                <TextBlock Text="Araçları üreticisinden edinin. Kurulum ve lisans koşulları üreticiye aittir. Kazancı aynı oyun/sahnede önce–sonra ölçün; PresentMon bir ölçüm aracıdır." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ComboBox x:Name="CmbExternalTool" DisplayMemberPath="Label" SelectedValuePath="Id" Width="250" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnExternalTool" Style="{StaticResource Btn}" Content="Resmî sayfayı aç"/>
                                    <Button x:Name="BtnWindowsPower" Style="{StaticResource Btn}" Content="Windows güç modları"/>
                                </WrapPanel>
                                <TextBlock Text="Kurulu planlar — Bitsum planını ParkControl/Process Lasso ile kurduktan sonra listeyi yenileyin. Seçim tek başına planı etkinleştirmez." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,4,0,6"/>
                                <Grid>
                                    <ComboBox x:Name="CmbInstalledPowerPlan" DisplayMemberPath="Label" SelectedValuePath="Guid" SelectedIndex="-1" IsEnabled="False" MinHeight="30">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"><Setter Property="ToolTip" Value="{Binding Guid}"/></Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <TextBlock Text="Bir güç planı seçin…" IsHitTestVisible="False" Foreground="#454545" Margin="8,0,28,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=CmbInstalledPowerPlan}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock x:Name="TxtPowerPlanStatus" Text="Güç planları ilk açılışta okunuyor…" TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,6,0,0"/>
                                <Button x:Name="BtnRefreshPowerPlans" Style="{StaticResource Btn}" Content="Kurulu planları yenile" HorizontalAlignment="Left" Margin="0,6,0,8"/>
                                <Button x:Name="BtnSelectIslc" Style="{StaticResource Btn}" Content="ISLC uygulama dosyasını seç…" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtIslcProfile" Text="ISLC 1.0.4.8: resmî paketi kalıcı bir klasöre çıkartıp içindeki uygulamayı seçin. RAM'e göre başlangıç profili gösterilecek; otomatik başlatmak için aşağıdaki ISLC ayarını önizleyip uygulayın." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="UserPreferencePanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="Alt menü gecikmesi (ms) — süreyi seçip ilgili ayarı işaretleyin:" Foreground="#B5BECE" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbMenuDelay" SelectedIndex="-1" Width="160" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <TextBlock Text="Adaptör ayarları için hedef seçin. TCP/IP (genel) ayarları sistem genelini etkiler." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,6"/>
                                <TextBlock Text="Hedef adaptör" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbNetworkDevice" DisplayMemberPath="Label" SelectedValuePath="InterfaceGuid" SelectedIndex="-1" MinWidth="240" HorizontalAlignment="Stretch" AutomationProperties.Name="Hedef adaptör"/>
                                <TextBlock x:Name="TxtNetworkTarget" Text="Hedef seçilmedi." TextWrapping="Wrap" Foreground="#FFC266" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="Sürücü tercihleri otomatik adaptör yeniden başlatması olmadan kaydedilir. Etkinleşmeleri için bilgisayarı yeniden başlatın." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,6,0,0"/>
                                <TextBlock Text="Bağlantı ölçümü — ping, dalgalanma (jitter), paket kaybı" FontSize="15" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,16,0,6"/>
                                <TextBlock Text="Modem, internet ve isteğe bağlı oyun sunucusu ölçülür; hiçbir ayar değişmez. Sorunun evde mi, hatta mı olduğunu gösterir. Ayar değiştirmeden önce ve sonra aynı koşullarda ölçüp karşılaştırın." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <TextBox x:Name="TxtPingTarget" Width="240" MinHeight="30" Padding="8,4" Background="#1B1F29" Foreground="#F0F2F7" CaretBrush="White" BorderBrush="#414B60" Margin="0,0,8,8"
                                             ToolTip="İsteğe bağlı: oyun sunucusunun IP adresi veya alan adı" AutomationProperties.Name="Ölçüm hedefi (isteğe bağlı)"/>
                                    <Button x:Name="BtnPingRun" Style="{StaticResource Btn}" Content="Ping ölç (~20 sn)" Margin="0,0,8,8"/>
                                    <Button x:Name="BtnDnsRun" Style="{StaticResource Btn}" Content="DNS hız testi" Margin="0,0,8,8"
                                            ToolTip="Mevcut DNS ile Cloudflare, Google ve Quad9'un yanıt sürelerini karşılaştırır. Ayar değiştirmez."/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtPingResult" Text="Henüz ölçüm yapılmadı." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,4"/>
                            </StackPanel>
                            <StackPanel x:Name="GraphicsPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                <Button x:Name="BtnGraphicsSettings" Style="{StaticResource Btn}" Content="Windows Grafik Ayarlarını aç" HorizontalAlignment="Left"/>
                                <TextBlock Text="Windows ekranındaki değişiklikler Livn Tools geri alma günlüğüne kaydedilmez." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,4,0,8"/>
                                <TextBlock Text="MSI hedef aygıtı" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbMsiDevice" DisplayMemberPath="Label" SelectedValuePath="InstanceId" SelectedIndex="-1" MinWidth="240" HorizontalAlignment="Stretch" AutomationProperties.Name="MSI hedef aygıtı"/>
                                <TextBlock x:Name="TxtMsiTarget" Text="MSI için aygıt seçilmedi." TextWrapping="Wrap" Foreground="#FFC266" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <Button x:Name="BtnReadGraphics" Style="{StaticResource Btn}" Content="HAGS durumunu ve seçili aygıtın MSI kaydını oku" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <TextBlock x:Name="TxtGraphicsState" Text="MSI seçeneklerini etkinleştirmek için listeden bir ekran kartı veya ağ kartı seçin. Okuma düğmesi ayar değiştirmez." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,8,0,0"/>
                                <TextBlock Text="Oyun GPU tercihi (dahili + harici ekran kartlı sistemler)" FontSize="15" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,16,0,6"/>
                                <WrapPanel>
                                    <Button x:Name="BtnGpuAddGame" Style="{StaticResource Btn}" Content="Oyun ekle (.exe)…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnGpuClearGames" Style="{StaticResource Btn}" Content="Listeyi temizle" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtGpuGames" Text="Eklenen oyun yok. Ekledikten sonra aşağıdaki &quot;Seçili oyunlar yüksek performanslı ekran kartını kullansın&quot; ayarını işaretleyin." TextWrapping="Wrap" Foreground="#B5BECE"/>
                            </StackPanel>
                            <ItemsControl x:Name="TweakGroups" ItemTemplate="{StaticResource TweakGroupTemplate}" Focusable="False"/>
                            <TextBlock x:Name="TxtCleanupHeader" Visibility="Collapsed" Text="Tek seferlik işlemler (geri alınamaz)" FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,8,0,8"/>
                            <ItemsControl x:Name="CleanupGroups" ItemTemplate="{StaticResource CleanupGroupTemplate}" Focusable="False"/>

                            <!-- SISTEM KONTROLU -->
                            <StackPanel x:Name="HealthPanel" Visibility="Collapsed">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnHealthRun" Style="{StaticResource BtnPrimary}" Content="Kontrolü çalıştır" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnHealthGamer" Style="{StaticResource Btn}" Content="Oyuncu modunu hazırla…" Margin="0,0,8,6"
                                            ToolTip="Oyun için uygun ayarları seçer ve önizlemeyi açar. Onay vermeden hiçbir şey değişmez."/>
                                    <Button x:Name="BtnHealthSave" Style="{StaticResource Btn}" Content="Raporu kaydet…" Margin="0,0,8,6"
                                            ToolTip="Sonuçları düz metin olarak kaydeder (bilgisayar ve kullanıcı adı yazılmaz)."/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtHealthSummary" Text="Kontrol salt okunurdur; hiçbir ayarı değiştirmez." TextWrapping="Wrap" Foreground="#C1ADF3" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="HealthList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1B1F29" BorderBrush="#303747" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border x:Name="badge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#1F3A26" BorderBrush="#5CBF60">
                                                            <TextBlock x:Name="badgeTxt" Text="{Binding StatusText}" FontSize="11" Foreground="#7FD686"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Area}" FontSize="11" Foreground="#939FB2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F0F2F7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Finding}" TextWrapping="Wrap" Foreground="#F0F2F7" Margin="0,6,0,0"/>
                                                    <TextBlock x:Name="adv" Text="{Binding Advice}" TextWrapping="Wrap" Foreground="#B5BECE" FontSize="12" Margin="0,4,0,0"/>
                                                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Margin="0,6,0,0">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><Button Style="{StaticResource Btn}" Content="{Binding Label}" Tag="{Binding Tag}" Margin="0,0,6,0" Padding="10,3" MinHeight="26"/></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Problem"><Setter TargetName="badge" Property="Background" Value="#3A1F22"/><Setter TargetName="badge" Property="BorderBrush" Value="#F4675C"/><Setter TargetName="badgeTxt" Property="Foreground" Value="#F4675C"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter TargetName="badge" Property="Background" Value="#3A2F1A"/><Setter TargetName="badge" Property="BorderBrush" Value="#FFA726"/><Setter TargetName="badgeTxt" Property="Foreground" Value="#FFC266"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Info"><Setter TargetName="badge" Property="Background" Value="#1C2A3A"/><Setter TargetName="badge" Property="BorderBrush" Value="#4A90D9"/><Setter TargetName="badgeTxt" Property="Foreground" Value="#8DBDF0"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Unknown"><Setter TargetName="badge" Property="Background" Value="#2A2D36"/><Setter TargetName="badge" Property="BorderBrush" Value="#939FB2"/><Setter TargetName="badgeTxt" Property="Foreground" Value="#B5BECE"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Advice}" Value=""><Setter TargetName="adv" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- KURTARMA KITI -->
                            <StackPanel x:Name="KitPanel" Visibility="Collapsed">
                                <TextBlock Text="1 · Formattan önce: kiti oluşturun" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,6"/>
                                <TextBlock Text="Sürücüler, uygulama listesi, Livn Tools ve ayarlarınız bir USB belleğe (veya başka bir diske) kopyalanır. Formattan sonra internet olmasa bile önce ağ sürücüsü kurulur. Kit oluşturmak sistemde hiçbir ayarı değiştirmez." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnKitBrowse" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Hedef klasör seç…" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtKitTarget" Text="Hedef seçilmedi (USB bellek önerilir; sistem sürücüsü kabul edilmez)." TextWrapping="Wrap" Foreground="#FFC266" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,4">
                                    <CheckBox x:Name="ChkKitNet" Content="Ağ sürücüleri (önerilir)" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitOther" Content="Diğer donanım sürücüleri (yonga seti, ses, Bluetooth…)" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitGpu" Content="Ekran kartı sürücüleri (büyük; üreticiden güncelini kurmanız önerilir)" IsChecked="False" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitApps" Content="Kurulu uygulama listesi" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitLivn" Content="Livn Tools kopyası ve ayarlarım" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitSaves" Content="Oyun kayıtları (Saved Games, Belgeler\My Games)" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="ChkKitWifi" Content="Wi-Fi ağları ve parolaları (düz metin saklanır)" IsChecked="False" Margin="0,0,16,6"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnKitPreview" Style="{StaticResource Btn}" Content="İçeriği önizle" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitCreate" Style="{StaticResource BtnPrimary}" Content="Kiti oluştur…" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtKitPlan" TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,16"/>
                                <TextBlock Text="2 · Formattan sonra: kiti geri yükleyin" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,6"/>
                                <TextBlock Text="Kitteki LivnTools\LivnTools.bat ile açarsanız kit kendiliğinden bulunur. Adımları sırayla izleyin; her adım ayrı onay ister ve Livn geri alma günlüğüne girmez (sürücüler Aygıt Yöneticisi'nden kaldırılabilir)." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnKitFind" Style="{StaticResource Btn}" Content="Kiti bul" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitOpen" Style="{StaticResource Btn}" Content="Kit klasörü seç…" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtKitSummary" Text="Kit yüklenmedi." TextWrapping="Wrap" Foreground="#C1ADF3" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="BtnKitDrivers" Style="{StaticResource BtnPrimary}" Content="① Sürücüleri kur (ağ önce)…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitWifi" Style="{StaticResource Btn}" Content="② Wi-Fi ağlarını ekle…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitApps" Style="{StaticResource Btn}" Content="③ Uygulamaları seç" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitTweaks" Style="{StaticResource Btn}" Content="④ Livn ayarlarını önizle…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnKitSaves" Style="{StaticResource Btn}" Content="⑤ Oyun kayıtlarını geri kopyala…" Margin="0,0,8,6"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- BASLANGIC UYGULAMALARI -->
                            <StackPanel x:Name="StartupPanel" Visibility="Collapsed">
                                <TextBlock Text="Windows açılışında başlayan uygulamalar" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,8"/>
                                <TextBlock Text="Kapatma Görev Yöneticisi ile aynı yöntemi kullanır; uygulama veya kısayol silinmez. Değişiklik bir sonraki oturum açılışında geçerli olur ve Değişiklik Geçmişi'nden geri alınabilir. Güvenlik yazılımlarının ve ses/dokunmatik yüzey sürücülerinin yardımcılarını kapatmayın." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnStartupDisable" Style="{StaticResource BtnPrimary}" Content="Seçilenleri açılıştan kaldır…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnStartupEnable" Style="{StaticResource Btn}" Content="Seçilenleri yeniden aç…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnStartupRefresh" Style="{StaticResource Btn}" Content="Listeyi yenile" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <ListBox x:Name="StartupList" ItemContainerStyle="{StaticResource SetupListItem}" SelectionMode="Multiple" Height="340" Background="#151A23" Foreground="#F0F2F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Başlangıç uygulamaları">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Command}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" FontSize="11" Foreground="#C1ADF3" Margin="12,0,0,0"/>
                                                    <TextBlock x:Name="st" DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11" Foreground="#7FD686" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Command}" FontSize="11" Foreground="#939FB2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StateText}" Value="Kapalı"><Setter TargetName="st" Property="Foreground" Value="#FFC266"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TxtStartupInfo" TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                                <TextBlock Text="Uygulama kurulumu — WinGet" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,8"/>
                                <TextBlock Text="İstediğiniz uygulamaları seçin; kurulumdan önce listeyi onaylayın. Kurulu olanlar yükseltilmeden atlanır." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <TextBlock Text="Uygulama ara — ad, açıklama veya paket kimliği" Foreground="#B5BECE" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetupSearch" MinHeight="32" Padding="8,5" Background="#1B1F29" Foreground="#F0F2F7" CaretBrush="White" BorderBrush="#414B60" Margin="0,0,8,0" AutomationProperties.Name="Uygulama ara"/>
                                    <ComboBox x:Name="CmbSetupCategory" Grid.Column="1" AutomationProperties.Name="Uygulama kategorisi"/>
                                </Grid>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="ChkSetupSelected" Content="Yalnız seçtiklerim" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button x:Name="BtnSetupClear" Style="{StaticResource BtnPreset}" Content="Uygulama seçimlerini temizle"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtSetupSelection" Foreground="#C1ADF3" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnSetupInventory" DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Kurulum durumunu yenile" VerticalAlignment="Top"
                                            ToolTip="WinGet envanterini salt okunur olarak yeniden okur (en fazla 30 saniyede bir). Kurulum veya güncelleme yapmaz."/>
                                    <Button x:Name="BtnWingetHelp" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="WinGet'i edinin / güncelleyin" VerticalAlignment="Top" Visibility="Collapsed" Margin="8,0,0,0"
                                            ToolTip="Microsoft Store'da Uygulama Yükleyici sayfasını açar. Store yoksa (LTSC/Server) Microsoft Learn kurulum yönergesi açılır. Hiçbir şey otomatik indirilmez."/>
                                    <TextBlock x:Name="TxtSetupInventory" Text="Kurulu durumu henüz okunmadı." TextWrapping="Wrap" Foreground="#B5BECE" VerticalAlignment="Center" AutomationProperties.Name="Kurulum durumu"/>
                                </DockPanel>
                                <Button x:Name="BtnSetupInstall" Style="{StaticResource BtnPrimary}" Content="Seçili uygulamaları kur…" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <ListBox x:Name="SetupAppList" ItemContainerStyle="{StaticResource SetupListItem}" SelectionMode="Multiple" Height="280" Background="#151A23" Foreground="#F0F2F7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Kurulacak uygulamalar">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding Id}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="11" Foreground="#C1ADF3" Margin="12,0,0,0"/>
                                                    <TextBlock x:Name="stateTxt" DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="11" Foreground="#939FB2" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#B5BECE" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Installed"><Setter TargetName="stateTxt" Property="Foreground" Value="#7FD686"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="InstalledExternal"><Setter TargetName="stateTxt" Property="Foreground" Value="#7FD686"/></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Unknown"><Setter TargetName="stateTxt" Property="Foreground" Value="#FFC266"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Filtre değişse de seçimler korunur. Kurulum onayında tüm seçili uygulamalar gösterilir. Hiçbiri otomatik seçilmez; kurulum bazı uygulamalara başlangıç veya arka plan bileşeni ekleyebilir." TextWrapping="Wrap" Foreground="#939FB2" Margin="0,6,0,0"/>
                                <Expander x:Name="SetupProfileSection" Header="Format profilim — kaydet / yükle" Style="{StaticResource SetupSection}" Margin="0,14,0,18">
                                    <StackPanel Margin="10,8,10,0">
                                <TextBlock Text="Benim format profilim" FontSize="18" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,8"/>
                                <TextBlock Text="Ayar sayfalarında seçimlerinizi yapın. Profil; görünüm, fare ivmesi, Oyun Modu, reklam tercihleri ve uygulama seçimlerini saklar. Donanım ayarları, temizlik, kaldırma seçimleri ve eski geri alma kayıtları taşınmaz." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="BtnProfileSave" Style="{StaticResource Btn}" Content="Seçimleri profile kaydet…"/>
                                    <Button x:Name="BtnProfileLoad" Style="{StaticResource Btn}" Content="Profil yükle…"/>
                                    <Button x:Name="BtnProfileApply" Style="{StaticResource BtnPrimary}" Content="Yüklenen ayarları önizle…"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtSetupProfile" Text="Profil yüklenmedi. Yüklemek tek başına ayar uygulamaz veya program kurmaz." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,6,0,8"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="İsteğe bağlı Windows uygulamaları" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F7" Margin="0,0,0,8"/>
                                <TextBlock Text="Yalnız mevcut kullanıcı hesabı etkilenir. Store, WebView, Xbox/Game Pass altyapısı ve sürücüler bu listede bulunmaz. Kaldırma uygulama verilerini silebilir; geri alma garantisi yoktur. Microsoft Store'dan yeniden kurmak eski verileri kurtarmaz." TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,0,0,8"/>
                                <Button x:Name="BtnSetupScan" Style="{StaticResource Btn}" Content="Kurulu olanları denetle" HorizontalAlignment="Left"/>
                                <ListBox x:Name="SetupRemoveList" ItemContainerStyle="{StaticResource SetupListItem}" SelectionMode="Multiple" DisplayMemberPath="Label" Height="135" Background="#151A23" Foreground="#F0F2F7" Margin="0,8,0,8"/>
                                <Button x:Name="BtnSetupRemove" Style="{StaticResource BtnDanger}" Content="Seçili uygulamaları kaldır…" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtSetupResults" TextWrapping="Wrap" Foreground="#B5BECE" Margin="0,12,0,0"/>
                            </StackPanel>

                            <!-- DEGISIKLIK GECMISI -->
                            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                                <TextBlock Text="Livn Tools'un değiştirdiği ve özgün değeri kayıtlı ayarlar" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ListView x:Name="LedgerList" Background="#15162C" Foreground="#F0F2F7" BorderBrush="#303747" MinHeight="140" MaxHeight="320" SelectionMode="Extended">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Ayar" Width="220" DisplayMemberBinding="{Binding Tweak}"/>
                                            <GridViewColumn Header="Hedef" Width="330" DisplayMemberBinding="{Binding Target}"/>
                                            <GridViewColumn Header="Özgün değer" Width="200" DisplayMemberBinding="{Binding Original}"/>
                                            <GridViewColumn Header="Tarih" Width="150" DisplayMemberBinding="{Binding Time}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <WrapPanel Margin="0,8,0,16">
                                    <Button x:Name="BtnHistoryRevert" Style="{StaticResource BtnPrimary}" Content="Seçili ayarları önceki değere döndür…"/>
                                    <Button x:Name="BtnHistoryRestoreFile" Style="{StaticResource Btn}" Content="Durum yedeğinden geri yükle…"/>
                                    <Button x:Name="BtnHistoryLegacyReg" Style="{StaticResource Btn}" Content="Eski .reg yedeğini içe aktar (v3.5)…"/>
                                    <Button x:Name="BtnHistoryOpenData" Style="{StaticResource Btn}" Content="Veri klasörünü aç"/>
                                </WrapPanel>
                                <TextBlock Text="İşlem günlüğü (journal)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ListView x:Name="OpsList" Background="#15162C" Foreground="#F0F2F7" BorderBrush="#303747" MinHeight="140" MaxHeight="300">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="İşlem" Width="210" DisplayMemberBinding="{Binding Id}"/>
                                            <GridViewColumn Header="Tür" Width="130" DisplayMemberBinding="{Binding Kind}"/>
                                            <GridViewColumn Header="Değişiklik" Width="90" DisplayMemberBinding="{Binding Changes}"/>
                                            <GridViewColumn Header="Sonuç" Width="170" DisplayMemberBinding="{Binding Outcome}"/>
                                            <GridViewColumn Header="Başlangıç" Width="190" DisplayMemberBinding="{Binding Started}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>

                            <!-- BETIK CALISTIR -->
                            <StackPanel x:Name="ScriptPanel" Visibility="Collapsed">
                                <Border Background="#3A1C22" BorderBrush="#8A3A3A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                    <TextBlock TextWrapping="Wrap" Foreground="#FFD0CA"
                                               Text="Betikler YÖNETİCİ yetkisiyle çalışır ve Livn Tools'un geri alma sistemine dahil DEĞİLDİR. Yalnızca içeriğini okuduğunuz ve güvendiğiniz betikleri çalıştırın."/>
                                </Border>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnScriptImport" Style="{StaticResource Btn}" Content="Dosyadan _içe aktar…"/>
                                    <ComboBox x:Name="CmbScriptKind" Width="170" Margin="0,0,8,8" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="PowerShell (.ps1)"/>
                                        <ComboBoxItem Content="Toplu iş (.bat/.cmd)"/>
                                    </ComboBox>
                                    <Button x:Name="BtnScriptRun" Style="{StaticResource BtnPrimary}" Content="Ç_alıştır…"/>
                                    <Button x:Name="BtnScriptClear" Style="{StaticResource Btn}" Content="Temizle"/>
                                </WrapPanel>
                                <TextBox x:Name="ScriptEditor" MinHeight="320" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="#0A0B16" Foreground="#D8D8E8" BorderBrush="#303747"
                                         CaretBrush="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Betik düzenleyici"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ILERLEME -->
            <Border x:Name="ProgressPanel" Grid.Row="4" Visibility="Collapsed" Background="#191C26" BorderBrush="#303747" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <Button x:Name="BtnCancel" DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="İptal (Esc)" Margin="12,0,0,0"
                            ToolTip="Mevcut adım bittikten sonra durur; yarım ayar bırakılmaz."/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProgress" Text="" Foreground="#F0F2F7" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ProgMain" Maximum="100" Margin="0,6,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- GUNLUK -->
            <Border Grid.Row="5" Background="#101217" BorderBrush="#303747" BorderThickness="0,1,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,4,8,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnLogToggle" Style="{StaticResource BtnPreset}" Content="Gizle"/>
                            <Button x:Name="BtnLogSave" Style="{StaticResource BtnPreset}" Content="Kaydet…"/>
                            <Button x:Name="BtnLogClear" Style="{StaticResource BtnPreset}" Content="Temizle"/>
                        </StackPanel>
                        <TextBlock Text="GÜNLÜK" FontSize="11" FontWeight="Bold" Foreground="#939FB2" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="LogBox" Height="80" IsReadOnly="True" BorderThickness="0" Background="#101217" Foreground="#9FE0B0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="12,6" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="İşlem günlüğü"/>
                </DockPanel>
            </Border>

            <!-- DURUM CUBUGU -->
            <Border Grid.Row="6" Background="#0B0C18" BorderBrush="#303747" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel>
                    <TextBlock x:Name="TxtDataRoot" DockPanel.Dock="Right" FontSize="11" Foreground="#939FB2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
